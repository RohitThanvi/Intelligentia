--+# root has an __init__.py), which drags that whole import chain into test
--+# COLLECTION -- requiring GCP credentials / the vertexai package even for a
--+# pure unit test that never touches RAG.
--+#
--+# --import-mode=importlib imports test files directly without walking up to
--+# parent packages, avoiding that entirely. tests/ still needs
--+# STRATEGIST_RAG_BACKEND=local / GOOGLE_API_KEY set (see tests/conftest.py)
--+# for the few tests that DO exercise the full agent tree.
--+addopts = --import-mode=importlib
