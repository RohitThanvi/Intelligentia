# Copy this file to .env and fill in real values. NEVER commit the real .env.
# All auth is Vertex AI / project-based (no AI Studio API key needed).

GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# RAG backend: "vertex" uses Vertex AI RAG Engine (default). Requires a corpus
# created ahead of time -- see README "Switching to Vertex AI RAG Engine".
STRATEGIST_RAG_BACKEND=vertex
RAG_CORPUS_RESOURCE_NAME=projects/your-project/locations/us-central1/ragCorpora/your-corpus-id

# --- App settings ---
STRATEGIST_MAX_ITERATIONS=3
STRATEGIST_DEFAULT_MODEL=gemini-2.5-flash
STRATEGIST_SYNTHESIS_MODEL=gemini-2.5-pro

# Set to TRUE if you're hitting 429 RESOURCE_EXHAUSTED (common on new/low-quota
# GCP projects) -- runs all specialist groups one at a time instead of in
# parallel, trading speed for staying under a tight requests-per-minute quota.
STRATEGIST_LOW_QUOTA_MODE=FALSE

# LOW_QUOTA_MODE above only removes BURSTS. If you still hit 429 even with it
# on (e.g. deep in a long sequential run), set this to your actual GCP quota's
# requests-per-minute limit to enforce real spacing between every single
# Gemini call in the tree. 0/unset disables this (default).
STRATEGIST_MAX_RPM=0

# Optional: route the pure-reasoning agents (red-team/validator/revision/
# evidence-audit/synthesis -- none use google_search or VertexAiRagRetrieval)
# through a different model provider via LiteLLM. Research/RAG agents stay
# on Gemini regardless -- google_search and VertexAiRagRetrieval are
# Gemini/Vertex-native and don't work via LiteLLM.
# "gemini" (default) = no change.
# "nvidia_nim" = NVIDIA NIM (e.g. Nemotron 3 Ultra). Free tier is hard-capped
#   at 40 RPM with no official increase path -- keep NVIDIA_MAX_RPM well
#   under that. Requires `pip install "google-adk[extensions]"`.
# "ollama" = fully local, zero external rate limit, but requires Ollama
#   installed and the model pulled first. The real Nemotron 3 Ultra (550B)
#   is not realistic on consumer hardware -- default here is a small,
#   genuinely local-friendly model instead.
STRATEGIST_REASONING_PROVIDER=gemini
STRATEGIST_REASONING_MODEL_ID=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_NIM_API_KEY=
STRATEGIST_NVIDIA_MAX_RPM=20
STRATEGIST_OLLAMA_MODEL_ID=llama3.1:8b
OLLAMA_API_BASE=http://localhost:11434
STRATEGIST_OLLAMA_NUM_CTX=16384
STRATEGIST_OLLAMA_TIMEOUT_SECONDS=300
